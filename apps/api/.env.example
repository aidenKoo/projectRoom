# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=projectroom

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_FN_CONTENT_MODERATOR_URL=https://your-project.supabase.co/functions/v1/content-moderator

# Photo Moderation
PHOTO_MODERATION_WEBHOOK_URL=http://localhost:3000/internal/photos/moderation
PHOTO_MODERATION_WEBHOOK_SECRET=your-webhook-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=projectroom-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

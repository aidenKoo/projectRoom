############
# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
############

# Database (MariaDB) - Production
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_USER=projectroom
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=projectroom

# Redis - Production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TTL=600

# NestJS
NODE_ENV=production
PORT=3000
API_PORT=3001

# Firebase (for Authentication & Storage)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-production-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Matching Algorithm Weights (v0 규칙 기반)
WEIGHT_COMMON_TAGS=0.25
WEIGHT_VALUES_MATCH=0.20
WEIGHT_TIME_OVERLAP=0.15
WEIGHT_DISTANCE=0.15
WEIGHT_RESPONSIVENESS=0.15
WEIGHT_QUALITY_SCORE=0.10

# Feed Settings
FEED_CANDIDATE_POOL_SIZE=200
FEED_RETURN_SIZE=20
FEED_CACHE_TTL_SECONDS=600

# CORS - Add your production frontend URLs
CORS_ORIGIN=https://your-production-domain.com,https://app.your-domain.com

# Logging
LOG_LEVEL=info

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      // Allow read/write if user is authenticated and accessing their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow other authenticated users to read basic user info for matching
      allow read: if request.auth != null;
    }

    // Matches collection rules
    match /matches/{matchId} {
      // Allow read if user is either fromUid or toUid
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);

      // Allow write by cloud functions and authenticated users for their own matches
      allow write: if request.auth != null;
    }

    // Notifications collection rules
    match /notifications/{notificationId} {
      // Allow read/write if user is the recipient (toUid)
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.toUid;

      // Allow write by cloud functions
      allow write: if request.auth != null;
    }

    // User FCM tokens collection
    match /userTokens/{userId} {
      // Allow read/write if user is authenticated and accessing their own token
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}